SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Gastzilla <info@gastzilla.de>

# Basis-URL der App, für Links in Benachrichtigungs-Mails (z.B. https://gastzilla.de)
NEXT_PUBLIC_SITE_URL=

